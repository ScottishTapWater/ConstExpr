<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageId>ConstExpr</PackageId>
    <Version>0.1.0</Version>
    <Authors>James Hughes</Authors>
    <Description>C# compile-time expressions with Roslyn analysers and source generation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ScottishTapWater/ConstExpr</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ScottishTapWater/ConstExpr</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>roslyn;analyser;source-generator;csharp;constexpr</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../ConstExpr.Core/bin/$(Configuration)/netstandard2.0/ConstExpr.Core.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../ConstExpr.Roslyn/bin/$(Configuration)/netstandard2.0/ConstExpr.Roslyn.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
